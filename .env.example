# Copy this to .env and fill in real values. Never commit .env itself.

# Backend
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://community:community@localhost:5432/community_search?sslmode=disable
REDIS_ADDR=localhost:6379
# Single CORS origin allowed to call the API. Must not be * — the server
# also sends Access-Control-Allow-Credentials: true, which browsers reject.
ALLOWED_ORIGIN=http://localhost:3000

# LLM (Phase 2) — Gemini API. The free tier needs no billing/credit card;
# get a key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
